{
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "node",
    "target": "ES2017",
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": true,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2017"
    ],
    "outDir": "dist/esm"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
